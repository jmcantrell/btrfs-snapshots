#!/usr/bin/env bash

# Show that `create` reports a missing subvolume and does nothing.

set -euo pipefail

source "$LIB_DIR"/init.bash
source "$TESTS_LIB_DIR"/init.bash

export PROFILE_FILE=unused
export SUBVOLUME=$TEMP_DIR/subvolume
export SNAPSHOTS=$TEMP_DIR/snapshots

printf -v stderr "test: subvolume is not available: %s\n" "$SUBVOLUME"

assert_success assert_stderr "$stderr" \
    do_create

readarray -t snapshots < <(print_snapshots "$SNAPSHOTS")

assert_equal "${#snapshots[@]}" 0
