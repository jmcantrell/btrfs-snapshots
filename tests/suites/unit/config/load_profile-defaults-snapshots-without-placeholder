#!/usr/bin/env bash

# Show that `load_profile` rejects a default `SNAPSHOTS` setting that does not
# contain a placeholder.

set -euo pipefail

source "$LIB_DIR"/init.bash
source "$TESTS_LIB_DIR"/init.bash

profile_file=$PROFILES_DIR/foo.conf

mkdir -p -- "$(dirname -- "$profile_file")"

printf "%s=%q\n" \
    SUBVOLUME "$TEMP_DIR" \
    >"$profile_file"

printf "%s=%q\n" \
    SNAPSHOTS "$TEMP_DIR" \
    >"$DEFAULTS_FILE"

printf -v stderr "test: configured default for SNAPSHOTS is missing the %%s placeholder: %q\n" "$TEMP_DIR"

assert_failure assert_stderr "$stderr" \
    load_profile "$profile_file"
